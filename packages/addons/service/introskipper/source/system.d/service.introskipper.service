[Unit]
Description=Intro Skipper Server Daemon
After=network-online.target

[Service]
ExecStart=/bin/sh -c "exec sh /storage/.kodi/addons/service.introskipper/bin/introskipper.start"
TimeoutStopSec=2
Restart=always
RestartSec=5
StartLimitInterval=0

[Install]
WantedBy=kodi.target
Alias=introskipper.service
