. /etc/profile

oe_setup_addon service.wayvnc

LD_LIBRARY_PATH=$ADDON_DIR/lib.private:$LD_LIBRARY_PATH
XDG_RUNTIME_DIR="/run/user/$(id -u)"
export WAYLAND_DISPLAY="${XDG_RUNTIME_DIR}/wayland-0"

/storage/.kodi/addons/service.wayvnc/bin/wayvnc --socket="${XDG_RUNTIME_DIR}/wayvnc 0.0.0.0"
