ACTION="${1:-up}"
STEP="${2:-5%}"
STATE_FILE="/run/alsa-volume.state"

# Determine mixer control (Master or PCM)
if amixer scontrols 2>/dev/null | grep -q "'Master'"; then
  MIXER="Master"
else
  MIXER="PCM"
fi

case "${ACTION}" in
  up)
    amixer set "${MIXER}" "${STEP}+" >/dev/null 2>&1
    ;;
  down)
    amixer set "${MIXER}" "${STEP}-" >/dev/null 2>&1
    ;;
  mute|toggle)
    # If the mixer control supports hardware pswitch (mute toggle)
    if amixer sget "${MIXER}" 2>/dev/null | grep -q "Capabilities:.*pswitch"; then
      amixer set "${MIXER}" toggle >/dev/null 2>&1
    else
      # Emulate mute for controls without hardware switch (e.g. vc4-hdmi PCM)
      if amixer sget "${MIXER}" 2>/dev/null | grep -q '\[0%\]'; then
        PREV=$(cat "${STATE_FILE}" 2>/dev/null || echo "100%")
        amixer set "${MIXER}" "${PREV}" >/dev/null 2>&1
      else
        VOL=$(amixer sget "${MIXER}" 2>/dev/null | grep -o '\[[0-9]*%\]' | head -n 1 | tr -d '[]')
        [ -n "${VOL}" ] && echo "${VOL}" > "${STATE_FILE}"
        amixer set "${MIXER}" 0% >/dev/null 2>&1
      fi
    fi
    ;;
esac

